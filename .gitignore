# ============================================================
# KUBERA MONOREPO — Root .gitignore
# ============================================================

# ──────────────────────────────────────────────────────────
# Operating System
# ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ──────────────────────────────────────────────────────────
# IDEs & Editors
# ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ──────────────────────────────────────────────────────────
# Environment Variables (NEVER commit secrets)
# ──────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
!.env.example

# ──────────────────────────────────────────────────────────
# Backend — Python / FastAPI
# ──────────────────────────────────────────────────────────
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/build/
**/dist/
**/*.egg-info/
**/*.egg
**/PIPFILE.lock
**/.venv/
**/venv/
**/venv_new/
**/ENV/
**/env/
**/.virtualenv/
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.tox/
**/.mypy_cache/
**/.dmypy.json
**/dmypy.json
**/.ipynb_checkpoints
**/.python-version
**/.uv/
**/uv.lock
**/*.pid
**/test_mcp_quick.py
**/test_mcp_servers.py

# ──────────────────────────────────────────────────────────
# Frontend — Node / React / Vite
# ──────────────────────────────────────────────────────────
**/node_modules/
**/.next/
**/out/
**/.nuxt/
**/.output/
**/dist/
**/.cache/
**/.parcel-cache/
**/build/

# ──────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────
**/*.log
**/logs/
**/log/
**/error_log.txt

# ──────────────────────────────────────────────────────────
# Database & Secrets
# ──────────────────────────────────────────────────────────
**/*.db
**/*.sqlite
**/*.sqlite3
**/secrets.json
**/credentials.json
**/*.pem
**/*.key
**/*.crt

# ──────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────
**/*.tmp
**/tmp/
**/temp/
**/uploads/
**/media/
**/static/uploads/
**/docs/_build/
**/site/
**/coverage.xml
**/*.cover
**/*.bak
